# 默认：文本文件自动识别换行，二进制不处理
* text=auto

# Java源码，仓库强制存储LF
*.java text eol=lf
# Maven配置
*.xml text eol=lf
# Markdown文档
*.md text eol=lf
# 属性配置文件
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# SQL脚本
*.sql text eol=lf

# 二进制文件，禁止换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.zip binary
